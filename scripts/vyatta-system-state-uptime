use strict;
use warnings;

use JSON;

my $proc_uptime_file = "/proc/uptime";

# Whole seconds since boot.
sub get_uptime {
    open my $fh, '<', $proc_uptime_file
      or die "Could not read from $proc_uptime_file\n";
    my $row = <$fh>;
    close $fh;
    my ($up_time) = ( $row // q{} ) =~ m{^(\d+)}x
      or die "Could not parse $proc_uptime_file\n";
    return ( uptime => $up_time );
}

my %out = get_uptime();

print encode_json( \%out );
