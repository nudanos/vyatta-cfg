use strict;
use warnings;

use JSON;

my $os_release_file = "/etc/os-release";

sub unquote {
    my ($value) = @_;
    $value =~ s{^"(.*)"}{$1}x;
    return $value;
}

# os-release as a hash of KEY => VALUE, empty if it can't be read.
sub read_os_release {
    open my $fh, '<', $os_release_file or return;
    my @lines = <$fh>;
    close $fh;
    return map { m{^(\w+)=(.*)$}x ? ( $1 => unquote($2) ) : () } @lines;
}

sub get_version {
    my %os = read_os_release();
    return (
        "os-version" => $os{VERSION_ID}  // $os{BUILD_ID} // "unknown",
        "os-name"    => $os{PRETTY_NAME} // $os{NAME}     // "unknown",
        "os-release" => $os{VYATTA_PROJECT_ID} // "unknown",
    );
}

my %out = get_version();

print encode_json( \%out );
