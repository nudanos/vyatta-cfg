use strict;
use warnings;

use JSON;

my $proc_meminfo_file = "/proc/meminfo";

# meminfo field => path of its value in the output
my %output_map = (
    "MemTotal"        => ["total-memory"],
    "MemFree"         => ["free-memory"],
    "MemAvailable"    => ["available-memory"],
    "Buffers"         => ["buffers"],
    "Cached"          => ["cached"],
    "SwapCached"      => ["swap-cached"],
    "Active"          => ["active"],
    "Inactive"        => ["inactive"],
    "Active(file)"    => ["active-file"],
    "Inactive(file)"  => ["inactive-file"],
    "Unevictable"     => ["unevictable"],
    "Mlocked"         => ["memory-locked"],
    "SwapTotal"       => ["swap-total"],
    "SwapFree"        => ["swap-free"],
    "Dirty"           => ["dirty"],
    "Writeback"       => ["writeback"],
    "AnonPages"       => ["anonymous-pages"],
    "Mapped"          => ["mapped"],
    "Shmem"           => ["shared-memory"],
    "Slab"            => ["slab"],
    "SReclaimable"    => ["slab-reclaimable"],
    "SUnreclaim"      => ["slab-non-reclaimable"],
    "KernelStack"     => ["kernel-stack"],
    "PageTables"      => ["page-tables"],
    "NFS_Unstable"    => ["nfs-unstable"],
    "Bounce"          => ["bounce"],
    "WritebackTmp"    => ["writeback-tmp"],
    "CommitLimit"     => ["commit-limit"],
    "Committed_AS"    => ["total-committed-memory"],
    "VmallocTotal"    => ["vmalloc-total"],
    "VmallocUsed"     => ["vmalloc-used"],
    "VmallocChunk"    => ["vmalloc-chunk"],
    "Active(anon)"    => [ "anonymous",  "active" ],
    "Inactive(anon)"  => [ "anonymous",  "inactive" ],
    "AnonHugePages"   => [ "huge-pages", "anonymous" ],
    "ShmemHugePages"  => [ "huge-pages", "shared-memory" ],
    "HugePages_Total" => [ "huge-pages", "total" ],
    "HugePages_Free"  => [ "huge-pages", "free" ],
    "HugePages_Rsvd"  => [ "huge-pages", "reserved" ],
    "HugePages_Surp"  => [ "huge-pages", "surplus" ],
    "Hugepagesize"    => [ "huge-pages", "size" ],
);

sub get_mem_info {
    open my $fh, '<', $proc_meminfo_file
      or die "Could not read from $proc_meminfo_file\n";
    my @lines = <$fh>;
    close $fh;

    my $out = {};
    foreach my $line (@lines) {
        my ( $field, $value, $unit ) = $line =~ m{^([^:]+): \s* (\d+) (?:\s+(\S+))?}x
          or next;
        my $path = $output_map{$field} or next;
        my $node = $out;
        $node = $node->{$_} //= {} foreach @{$path}[ 0 .. $#{$path} - 1 ];
        $node->{ $path->[-1] } = $value * ( $unit ? 1024 : 1 );
    }
    return $out;
}

print encode_json( get_mem_info() );
