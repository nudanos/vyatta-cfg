BOOT_FILE=$1
shift

CAPI=${BOOT_CONFIG_CAPI:-/bin/cli-shell-api}
# Executables run before the boot configuration is loaded, as
# "<hook> <boot file>" (e.g. to set aside configuration a release cannot
# load). A failing hook is logged and does not stop the boot.
HOOK_DIR=${BOOT_CONFIG_HOOK_DIR:-/opt/vyatta/etc/boot-config.d}

do_commit () {
  cfgcli commit "$@"
}

umask 0002

(
  echo 'begin boot-config-loader'
  # set up config session
  SID=$$
  SENV=$($CAPI getSessionEnv $SID)
  eval "$SENV"
  if ! $CAPI setupSession; then
    echo 'Cannot set up configuration session.' 1>&2
    exit 1
  fi

  # boot-config hooks
  if [ -d "$HOOK_DIR" ]; then
    for hook in $(LC_ALL=C ls "$HOOK_DIR"); do
      path=$HOOK_DIR/$hook
      [ -f "$path" ] && [ -x "$path" ] || continue
      "$path" "$BOOT_FILE"
      status=$?
      if [ $status -eq 0 ]; then
        echo "boot-config hook $hook: ok"
      else
        echo "boot-config hook $hook: failed ($status)" 1>&2
      fi
    done
  fi

  # do load
  echo 'begin load'
  if ! $CAPI loadFile "$BOOT_FILE"; then
    echo 'load finished with failure(s)' 1>&2
  else
    echo 'load finished successfully'
  fi

  # do commit
  echo 'begin commit'
  ret=0
  export COMMIT_VIA=boot-config-loader
  if ! do_commit ; then
    echo 'commit failed' 1>&2
    ret=1
  else
    echo 'commit succeeded'
  fi

  # clean up
  if ! $CAPI teardownSession; then
    echo 'teardown failed' 1>&2
  else
    echo 'teardown succeeded'
  fi
  echo 'end boot-config-loader'
  exit $ret
) </dev/null

exit $?

