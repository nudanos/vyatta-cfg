use Getopt::Long;
use lib "/opt/vyatta/share/perl5/";
use strict;
use warnings;

use File::Basename;

my $ri_name;
my $outfile;
my $infile;
GetOptions(
    'ri=s'      => \$ri_name,
    'outfile=s' => \$outfile,
    'infile=s'  => \$infile,
);

my $progname = basename($0);

sub usage {
    return
      "Usage: $progname [ --ri=<ri_name> ] [ --outfile=<filename> | --infile=<filename> ] <url>\n";
}

# Runs a command and returns its combined stdout and stderr.
sub capture {
    my (@cmd) = @_;
    my $pid   = open my $fh, '-|';
    die "Cannot fork: $!\n" if !defined $pid;
    if ( !$pid ) {
        open STDERR, '>&', \*STDOUT or die "Cannot redirect stderr: $!\n";
        exec @cmd or die "Exec @cmd failed: $!\n";
    }
    my $out = do { local $/ = undef; <$fh> }
      // q{};
    close $fh;
    return $out;
}

sub check_http {
    my ($url) = @_;

    #
    # error codes are send back in html, so 1st try a header
    # and look for "HTTP/1.1 200 OK"
    #
    my $rc = capture( 'vyatta-curl-wrapper', '-q', '-s', '-I', $url );
    my ( $rc_code, $rc_string ) = $rc =~ m{HTTP/\d+[.]?\d \s+ (\d+) \s+ (.*)$}mix
      or die "Error: $rc\n";
    die "http error: [$rc_code] $rc_string\n" if $rc_code != 200;
    return;
}

if ( @ARGV != 1 ) {
    print {*STDERR} usage();
    exit 1;
}

my $url = $ARGV[0];
my ($proto) = $url =~ m{(^[^/]\w+)://}x
  or die "Can not parse URL $url\n";

my @file_arg =
    $outfile ? ("--outfile=$outfile")
  : $infile  ? ("--infile=$infile")
  :            ();
if ($ri_name) {

    # re-exec in the proper routing-instance, leaving off ri_name
    my @args = ( "/usr/sbin/chvrf", $ri_name, $0, @file_arg, $url );
    exec @args or die "Exec @args failed: $!\n";
}

check_http($url) if $proto eq 'http';

my @curl_file =
    $outfile ? ( "-o", $outfile )
  : $infile  ? ( "-T", $infile )
  :            ();                  # return data in stdout
my @args = ( "vyatta-curl-wrapper", "-#", @curl_file, $url );
exec @args or die "Exec @args failed: $!\n";
