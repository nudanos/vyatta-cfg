use strict;
use warnings;

use JSON;

# output leaf => mpstat column
my @columns = (
    [ "cpu"         => "CPU" ],
    [ "user"        => "%usr" ],
    [ "nice"        => "%nice" ],
    [ "sys"         => "%sys" ],
    [ "iowait"      => "%iowait" ],
    [ "irq"         => "%irq" ],
    [ "soft"        => "%soft" ],
    [ "steal"       => "%steal" ],
    [ "guest"       => "%guest" ],
    [ "niced-guest" => "%gnice" ],
    [ "idle"        => "%idle" ],
);

# Columns are found by name in mpstat's header line and counted from the
# right, so a 12-hour time ("10:17:35 AM") and a 24-hour one parse alike.
sub get_cpu_utils {
    open my $fh, '-|', 'mpstat', '-P', 'ALL'
      or die "Could not run mpstat\n";
    my @lines = <$fh>;
    close $fh;

    my ( @util_out, %index );
    foreach my $line (@lines) {
        my @fields = split q{ }, $line;
        if ( !%index ) {
            next if !grep { $_ eq 'CPU' } @fields;
            %index = map { $fields[$_] => $_ - @fields } 0 .. $#fields;
            next;
        }
        last if !@fields;
        push @util_out, { map { $_->[0] => $fields[ $index{ $_->[1] } ] } @columns };
    }
    return ( utilization => \@util_out );
}

my %out = get_cpu_utils();

print encode_json( \%out );
